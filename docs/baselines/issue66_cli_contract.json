  "argument_cases": [
    {
      "argv": [
        "video.mp4"
      ],
      "expected_parse": {
        "input": "video.mp4",
        "target": "both",
        "game_lang": "auto",
        "seconds_before": 5.0,
        "seconds_after": 1.0,
        "min_event_sec": 2.0,
        "molotov_elim_before": 10.0,
        "scan_mode": "auto",
        "jobs": null,
        "dry_run": false,
        "merge": null
      }
    },
    {
      "argv": [
        "--files",
        "video1.mp4",
        "video2.mp4",
        "--scan-only",
        "--jobs",
        "2"
      ],
      "expected_parse": {
        "files": [
          "video1.mp4",
          "video2.mp4"
        ],
        "dry_run": true,
        "jobs": 2
      }
    },
    {
      "argv": [
        "video.mp4",
        "--merge"
      ],
      "expected_parse": {
        "merge": true
      }
    },
    {
      "argv": [
        "video.mp4",
        "--no-merge"
      ],
      "expected_parse": {
        "merge": false
      }
    },
    {
      "argv": [
        "video.mp4",
        "--game-lang",
        "zh-Hant",
        "--target",
        "own-kill",
        "--before",
        "0",
        "--after",
        "2.5"
      ],
      "expected_parse": {
        "game_lang": "zh-Hant",
        "target": "own-kill",
        "seconds_before": 0.0,
        "seconds_after": 2.5
      }
    },
    {
      "argv": [
        "video.mp4",
        "--scan-mode",
        "full",
        "--coarse-step",
        "2",
        "-o",
        "scan"
      ],
      "expected_parse": {
        "scan_mode": "full",
        "coarse_step": 2.0,
        "output_dir": "scan"
      }
    }
  ],
