<Window x:Class="PubgHighlightTrim.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PUBG Highlight Trim" Width="1120" Height="780"
        MinWidth="940" MinHeight="680" WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#17201D" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="6" Background="{StaticResource WarmBrush}"
                        VerticalAlignment="Center">
                    <TextBlock Text="P" FontSize="19" FontWeight="Black" Foreground="#17201D"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="PUBG Highlight Trim" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="OCR 视频剪辑工作台" Foreground="#AEB8B4" FontSize="11" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="CliStatusDot" Width="8" Height="8" Fill="#7F8B86" Margin="0,0,7,0" />
                    <TextBlock x:Name="CliStatusText" Text="正在检查 CLI" Foreground="#CBD2CF" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" Padding="24,18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="输入" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="视频（可多选）或文件夹" Style="{StaticResource FieldLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="InputPathTextBox" TextChanged="InputPathTextBox_TextChanged"
                                     ToolTip="PUBG NVIDIA Highlight 文件夹，或一个/多个 MP4 文件" />
                            <Button x:Name="BrowseFolderButton" Grid.Column="1" Content="&#xE8B7;" Style="{StaticResource IconButton}"
                                    Margin="6,0,0,0" ToolTip="选择文件夹" Click="BrowseFolder_Click" />
                            <Button x:Name="BrowseFileButton" Grid.Column="2" Content="&#xE8A5;" Style="{StaticResource IconButton}"
                                    Margin="6,0,0,0" ToolTip="选择一个或多个 MP4 文件" Click="BrowseFile_Click" />
                        </Grid>

                        <TextBlock Text="输出目录（留空则由 CLI 自动创建）" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OutputPathTextBox" />
                            <Button x:Name="BrowseOutputButton" Grid.Column="1" Content="&#xE8B7;" Style="{StaticResource IconButton}"
                                    Margin="6,0,0,0" ToolTip="选择输出目录" Click="BrowseOutput_Click" />
                        </Grid>

                        <TextBlock Text="检测目标" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
                        <Border Background="#F7F9F8" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="1">
                            <UniformGrid Columns="3">
                                <RadioButton x:Name="TargetBoth" Content="全部" GroupName="Target" IsChecked="True"
                                             Style="{StaticResource SegmentButton}" />
                                <RadioButton x:Name="TargetSelfDeath" Content="自己倒地" GroupName="Target"
                                             Style="{StaticResource SegmentButton}" />
                                <RadioButton x:Name="TargetOwnKill" Content="我的击杀" GroupName="Target"
                                             Style="{StaticResource SegmentButton}" />
                            </UniformGrid>
                        </Border>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="游戏语言" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="LanguageComboBox" SelectedIndex="0">
                                    <ComboBoxItem Content="自动识别" Tag="auto" />
                                    <ComboBoxItem Content="简体中文" Tag="zh-Hans" />
                                    <ComboBoxItem Content="繁体中文" Tag="zh-Hant" />
                                    <ComboBoxItem Content="English" Tag="en" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="扫描模式" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="ScanModeComboBox" SelectedIndex="0">
                                    <ComboBoxItem Content="自动" Tag="auto" />
                                    <ComboBoxItem Content="快速" Tag="fast" />
                                    <ComboBoxItem Content="完整" Tag="full" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="剪辑范围" Style="{StaticResource SectionLabel}" Margin="0,18,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="事件前（秒）" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="BeforeTextBox" Text="5" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="事件后（秒）" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="AfterTextBox" Text="1" />
                            </StackPanel>
                        </Grid>

                        <WrapPanel Margin="0,16,0,0">
                            <CheckBox x:Name="MergeCheckBox" Content="合并输出" IsChecked="True" Margin="0,0,18,8" />
                            <CheckBox x:Name="RecursiveCheckBox" Content="递归扫描子文件夹" Margin="0,0,18,8"
                                      ToolTip="勾选后搜索所选文件夹内的所有子文件夹；默认只扫描当前文件夹" />
                            <CheckBox x:Name="ScanOnlyCheckBox" Content="仅扫描" Margin="0,0,18,8" />
                            <CheckBox x:Name="OverwriteCheckBox" Content="覆盖输出" Margin="0,0,18,8" />
                        </WrapPanel>

                        <Expander Header="专家设置" Margin="0,10,0,0" Expanded="AdvancedExpander_Expanded">
                            <StackPanel Margin="0,12,0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="忽略开场事件" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="MinEventTextBox" Text="2" ToolTip="秒；0 表示保留开场事件" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="燃烧瓶前置" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="MolotovTextBox" Text="10" ToolTip="秒；0 表示禁用特殊前置" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="并行任务" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="JobsTextBox" Text="auto" ToolTip="auto 或正整数" />
                                    </StackPanel>
                                </Grid>
                                <CheckBox x:Name="BrightnessGateCheckBox" Content="启用亮色描边文字预筛选"
                                          IsChecked="True" Margin="0,14,0,0" />
                            </StackPanel>
                        </Expander>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,18,0,16" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="46" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="RunButton" Content="开始处理" Style="{StaticResource PrimaryButton}"
                                    Click="RunButton_Click" IsEnabled="False" />
                            <Button x:Name="CancelButton" Grid.Column="1" Content="&#xE71A;" Style="{StaticResource IconButton}"
                                    Margin="8,0,0,0" ToolTip="停止当前任务" Click="CancelButton_Click" IsEnabled="False" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource BorderBrush}" />

            <Grid Grid.Column="2" Margin="28,22,28,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="RunTitleText" Text="准备处理" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock x:Name="RunSubtitleText" Text="选择精彩时刻文件夹或一个/多个 MP4 文件"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="OpenOutputButton" Content="打开输出" Style="{StaticResource SecondaryButton}"
                                Click="OpenOutputButton_Click" IsEnabled="False" Margin="0,0,8,0" />
                        <Button x:Name="PlayMergedButton" Content="播放合并视频" Style="{StaticResource SecondaryButton}"
                                Click="PlayMergedButton_Click" IsEnabled="False" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" Margin="0,22,0,18" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="进度" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                            <TextBlock x:Name="ProgressMetricText" Text="--" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="已保留" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                            <TextBlock x:Name="IncludedMetricText" Text="0" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="已跳过" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                            <TextBlock x:Name="SkippedMetricText" Text="0" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="耗时" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                            <TextBlock x:Name="DurationMetricText" Text="--" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0" />
                        </StackPanel>
                        <ProgressBar x:Name="RunProgressBar" Grid.Row="1" Grid.ColumnSpan="4" Height="5" Margin="0,16,0,0"
                                     Minimum="0" Maximum="1" Value="0" Foreground="{StaticResource AccentBrush}" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="运行记录" FontWeight="SemiBold" FontSize="14" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ToggleButton x:Name="LogToggleButton" Content="显示日志" MinWidth="78" Height="30"
                                          Padding="10,5" Background="White" BorderBrush="{StaticResource BorderBrush}"
                                          BorderThickness="1" Cursor="Hand" ToolTip="显示或收起 CLI 原始日志">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Content" Value="显示日志" />
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Content" Value="收起日志" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Button Content="&#xE74D;" Width="32" Height="30"
                                    Margin="6,0,0,0" ToolTip="清空记录" Click="ClearLog_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=LogToggleButton}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Border x:Name="ActivityPanel" Grid.Row="1" Background="#F8FAF9"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Margin="0,10,0,0" Padding="28">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=LogToggleButton}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid VerticalAlignment="Center" MaxWidth="620">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="56" Height="56" CornerRadius="28" Background="#E5F3ED"
                                    VerticalAlignment="Top">
                                <TextBlock x:Name="ActivityGlyphText" Text="◈" FontSize="24"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="ActivityTitleText" Text="准备开始" FontSize="18"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="ActivityDescriptionText" Text="选择输入后，运行状态和结果会显示在这里"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="ActivityProgressText" Text="等待输入"
                                           Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"
                                           Margin="0,16,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Background="#101714" BorderBrush="#26312D" BorderThickness="1"
                            CornerRadius="6" Margin="0,10,0,0" Padding="2">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=LogToggleButton}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <ListBox x:Name="LogListBox" Background="Transparent" BorderThickness="0"
                                 Foreground="#DDE6E2" FontFamily="Cascadia Mono" FontSize="11"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="10,4" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#25352F" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>
                </Grid>

                <Border Grid.Row="3" Background="#FFF8E8" BorderBrush="#ECD9AE" BorderThickness="1"
                        CornerRadius="6" Margin="0,16,0,0" Padding="12,9">
                    <TextBlock x:Name="CommandPreviewText" Text="CLI 命令将在这里显示" Foreground="#6B5529"
                               FontFamily="Cascadia Mono" FontSize="10" TextTrimming="CharacterEllipsis"
                               ToolTip="CLI 命令预览" />
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#E8ECEA" Padding="14,0">
            <Grid>
                <TextBlock x:Name="FooterStatusText" Text="就绪" Foreground="{StaticResource MutedBrush}"
                           FontSize="11" VerticalAlignment="Center" />
                <TextBlock Text="UI 0.3.5 · CLI black-box mode" Foreground="#87918D" FontSize="10"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
